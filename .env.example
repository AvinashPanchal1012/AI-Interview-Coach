# ---- Server ----
PORT=5000
# Comma-separated list of allowed browser origins (Vite dev server by default)
CLIENT_ORIGIN=http://localhost:5173

# ---- Database ----
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/ai-interview-coach
# MongoDB Atlas (replace user, password and cluster):
# MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/ai-interview-coach?retryWrtites=true&w=majority

# ---- Authentication ----
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret
JWT_EXPIRES_IN=7d

# ---- One-time first admin (created on server start ONLY if no admin exists) ----
# After the admin has been created, delete ADMIN_PASSWORD from your .env file.
ADMIN_NAME=Site Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password-min-10-chars
